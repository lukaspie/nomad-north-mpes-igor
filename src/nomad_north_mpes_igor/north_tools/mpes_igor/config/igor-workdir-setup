# Make NOMAD's mounted work/uploads directories reachable from inside the Wine Igor
# environment (Igor's own file dialogs only see paths under the Wine C: drive).
ln -s /home/jovyan/work /home/jovyan/.wine/drive_c/users/jovyan/Desktop/work
ln -s /home/jovyan/uploads /home/jovyan/.wine/drive_c/users/jovyan/Desktop/uploads

# Trusting the Igor desktop shortcut itself is handled by nomad-north-desktop-base's
# generic trust-desktop-icons autostart entry (see its own config/), which covers every
# icon on the Desktop, not just this one - this file must use a name distinct from that
# base image's own autostart.desktop/autostart, or it silently overwrites it (as happened
# before), leaving every non-Igor icon (Chrome, silx, VS Code, ...) untrusted again.
